{
  "name": "mazdak-pool-deck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:customer": "node scripts/dev-page.mjs customer",
    "dev:financials": "node scripts/dev-page.mjs financials",
    "build": "npm run check && tsc -b && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "node scripts/check-content.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\"",
    "publish": "npm run build && node scripts/publish.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
